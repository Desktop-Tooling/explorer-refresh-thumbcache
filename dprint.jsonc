{
  "extends": [],
  "plugins": [
    "https://plugins.dprint.dev/json-0.15.4.wasm",
    "https://plugins.dprint.dev/markdown-0.15.3.wasm"
  ],
  "json": {
    "indentWidth": 2,
    "lineWidth": 100
  },
  "markdown": {
    "lineWidth": 100
  },
  "includes": ["**/*.json", "**/*.jsonc", "**/*.md", "**/*.adoc"],
  "excludes": ["node_modules", "bin", "obj", "dist", "publish"]
}
